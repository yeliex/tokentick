"Filter dates must use a valid YYYY-MM-DD format." = "筛选日期必须为有效的 YYYY-MM-DD。";
"Log scan issues: %lld. Successfully collected data was kept." = "日志扫描发现 %lld 个问题，已保留成功采集的数据。";
"Logs: %@" = "日志：%@";
"Missing session_meta before a usage event." = "用量事件前缺少 session_meta。";
